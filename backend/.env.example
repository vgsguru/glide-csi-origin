# Copy to .env (or set these in your host's dashboard) before deploying.

# Sign the auth tokens. MUST be changed from the default in production.
GLIDE_SECRET_KEY=change-me-to-something-random

# SQLite works for a demo; point at Postgres for anything real.
# GLIDE_DATABASE_URL=postgresql://user:pass@host:5432/glide

# A deployed backend has no GPU, so point it at Ollama Cloud.
# Without these it falls back to the deterministic rule engine, which still
# answers affordability, buffer and spending questions correctly.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your-key-from-ollama.com/settings/keys
# GLIDE_MODEL=gemma4:31b-cloud
